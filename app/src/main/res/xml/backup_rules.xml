<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11(API 30) 이하의 백업 규칙. 12 이상은 data_extraction_rules.xml 을 쓴다.
  로그인 토큰과 로그인 사용자는 백업하지 않는다(이유는 그 파일 주석 참고).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="safelight_auth.xml" />
    <exclude domain="sharedpref" path="safelight_session.xml" />
</full-backup-content>
